{
  "name": "codex-game-asset-workbench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm --workspace @cgawe/workbench run build",
    "build:packages": "tsc -b packages/schema packages/core packages/adapter-three packages/cli",
    "dev": "npm run build:packages && npm --workspace @cgawe/workbench run dev",
    "preview": "npm --workspace @cgawe/workbench run preview",
    "schema:sync": "npm run build:packages && node scripts/sync-schema.mjs",
    "schema:check": "npm run build:packages && node scripts/sync-schema.mjs --check",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "npm run build:packages && vitest run",
    "test:direct-manipulation": "npm run build && node scripts/browser-direct-manipulation-smoke.mjs",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs && node scripts/paper-glider-compat-smoke.mjs",
    "compat:generate:bundle": "npm run build:packages && node scripts/generate-paper-glider-compat.mjs",
    "compat:generate": "npm run compat:generate:bundle && node scripts/paper-glider-compat-smoke.mjs --write",
    "compat:check": "npm run build:packages && node scripts/verify-paper-glider-compat.mjs",
    "compat:visual": "node scripts/paper-glider-compat-smoke.mjs",
    "runtime:generate": "npm run build:packages && node scripts/runtime-bundle-proof.mjs --write",
    "runtime:check": "npm run build:packages && node scripts/runtime-bundle-proof.mjs",
    "verify": "npm run schema:check && npm run build && npm run typecheck && npm run lint && npm run test && npm run runtime:check && npm run compat:check && npm run test:browser && git diff --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.15",
    "ajv": "^8.20.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "playwright": "^1.54.1",
    "three": "^0.178.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
