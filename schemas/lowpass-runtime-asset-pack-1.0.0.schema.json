{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgawe.local/schemas/lowpass-runtime-asset-pack-1.0.0.schema.json",
  "title": "LOWPASS Runtime Asset Pack Manifest 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assetPackId",
    "assetKey",
    "recipeHash",
    "generatorVersion",
    "sourceRuntimeBundleContractVersion",
    "coordinateSystem",
    "unitScaleMeters",
    "files",
    "stableNodeMap",
    "meshNodeIds",
    "materialIds",
    "socketIds",
    "collisionProxyIds",
    "interactionAnchorIds",
    "assets",
    "bounds",
    "triangleCount",
    "vertexCount",
    "materialCount",
    "textureDimensions",
    "lods",
    "budgets",
    "sourceProvenance",
    "license",
    "deterministicBuildReadback",
    "textureStage"
  ],
  "properties": {
    "schemaVersion": { "const": "lowpass-runtime-asset-pack-1.0.0" },
    "assetPackId": { "$ref": "#/$defs/nonEmptyString" },
    "assetKey": { "type": "string", "pattern": "^lowpass:" },
    "recipeHash": { "type": "string", "pattern": "^fnv1a-[0-9a-f]{8}$" },
    "generatorVersion": { "$ref": "#/$defs/nonEmptyString" },
    "sourceRuntimeBundleContractVersion": { "const": "cgawe-runtime-bundle-1.0.0" },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handedness", "upAxis", "forwardAxis"],
      "properties": {
        "handedness": { "const": "right" },
        "upAxis": { "const": "+Y" },
        "forwardAxis": { "const": "-Z" }
      }
    },
    "unitScaleMeters": { "const": 1 },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["glb", "manifest", "readback", "visualProofs"],
      "properties": {
        "glb": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "mediaType", "bytes", "sha256"],
          "properties": {
            "name": { "type": "string", "pattern": "^[^/\\\\]+\\.runtime\\.glb$" },
            "mediaType": { "const": "model/gltf-binary" },
            "bytes": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "mediaType"],
          "properties": {
            "name": { "type": "string", "pattern": "^[^/\\\\]+\\.manifest\\.json$" },
            "mediaType": { "const": "application/json" }
          }
        },
        "readback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "mediaType"],
          "properties": {
            "name": { "type": "string", "pattern": "^[^/\\\\]+\\.readback\\.json$" },
            "mediaType": { "const": "application/json" }
          }
        },
        "visualProofs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "mode", "mediaType"],
            "properties": {
              "name": { "type": "string", "pattern": "^[^/\\\\]+\\.png$" },
              "mode": { "enum": ["ps1-off", "ps1-on"] },
              "mediaType": { "const": "image/png" }
            }
          }
        }
      }
    },
    "stableNodeMap": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stableNode" }
    },
    "meshNodeIds": { "$ref": "#/$defs/stringArray" },
    "materialIds": { "$ref": "#/$defs/stringArray" },
    "socketIds": { "$ref": "#/$defs/stringArray" },
    "collisionProxyIds": { "$ref": "#/$defs/stringArray" },
    "interactionAnchorIds": { "$ref": "#/$defs/stringArray" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetId",
          "assetKey",
          "instanceId",
          "rootNodeId",
          "role",
          "faction",
          "forwardAxis",
          "stableNodeIds",
          "meshNodeIds",
          "visualNodeIds",
          "materialIds",
          "socketIds",
          "collisionProxyIds",
          "interactionAnchorIds",
          "anchors",
          "features",
          "bounds",
          "triangleCount",
          "vertexCount",
          "materialCount",
          "textureDimensions",
          "lods",
          "sourceProvenance"
        ],
        "properties": {
          "assetId": { "$ref": "#/$defs/nonEmptyString" },
          "assetKey": { "type": "string", "pattern": "^lowpass:" },
          "instanceId": { "$ref": "#/$defs/nonEmptyString" },
          "rootNodeId": { "$ref": "#/$defs/nonEmptyString" },
          "role": { "enum": ["hostile-needle", "hostile-watcher", "allied-porter", "push-cart", "field-terminal"] },
          "faction": { "enum": ["hostile", "allied", "neutral"] },
          "forwardAxis": { "const": "-Z" },
          "stableNodeIds": { "$ref": "#/$defs/stringArray" },
          "meshNodeIds": { "$ref": "#/$defs/stringArray" },
          "visualNodeIds": { "$ref": "#/$defs/stringArray" },
          "materialIds": { "$ref": "#/$defs/stringArray" },
          "socketIds": { "$ref": "#/$defs/stringArray" },
          "collisionProxyIds": { "$ref": "#/$defs/stringArray" },
          "interactionAnchorIds": { "$ref": "#/$defs/stringArray" },
          "anchors": {
            "type": "array",
            "items": { "$ref": "#/$defs/anchor" }
          },
          "features": {
            "type": "array",
            "items": { "$ref": "#/$defs/feature" }
          },
          "bounds": { "$ref": "#/$defs/bounds" },
          "triangleCount": { "$ref": "#/$defs/count" },
          "vertexCount": { "$ref": "#/$defs/count" },
          "materialCount": { "$ref": "#/$defs/count" },
          "textureDimensions": { "$ref": "#/$defs/textureDimensions" },
          "lods": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["level", "nodeIds", "maxDistanceMeters"],
              "properties": {
                "level": { "const": 0 },
                "nodeIds": { "$ref": "#/$defs/stringArray" },
                "maxDistanceMeters": { "type": "null" }
              }
            }
          },
          "sourceProvenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceRecipe", "generatedFromPrimitives", "rightsStatus"],
            "properties": {
              "sourceRecipe": { "$ref": "#/$defs/nonEmptyString" },
              "generatedFromPrimitives": { "const": true },
              "rightsStatus": { "enum": ["NOASSERTION", "DECLARED"] }
            }
          }
        }
      }
    },
    "bounds": { "$ref": "#/$defs/bounds" },
    "triangleCount": { "$ref": "#/$defs/count" },
    "vertexCount": { "$ref": "#/$defs/count" },
    "materialCount": { "$ref": "#/$defs/count" },
    "textureDimensions": { "$ref": "#/$defs/textureDimensions" },
    "lods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "assetIds", "maxDistanceMeters"],
        "properties": {
          "level": { "const": 0 },
          "assetIds": { "$ref": "#/$defs/stringArray" },
          "maxDistanceMeters": { "type": "null" }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxTrianglesPerAsset", "maxMaterialsPerAsset", "maxTextureDimension"],
      "properties": {
        "maxTrianglesPerAsset": { "type": "integer", "minimum": 1 },
        "maxMaterialsPerAsset": { "type": "integer", "minimum": 1 },
        "maxTextureDimension": { "type": "integer", "minimum": 1 }
      }
    },
    "sourceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoringTool", "sourceType", "externalNetworkDependency", "notice", "sourceRecipe", "recipeSchemaVersion"],
      "properties": {
        "authoringTool": { "$ref": "#/$defs/nonEmptyString" },
        "sourceType": { "const": "project-owned-procedural-recipe" },
        "externalNetworkDependency": { "const": false },
        "notice": { "$ref": "#/$defs/nonEmptyString" },
        "sourceRecipe": { "$ref": "#/$defs/nonEmptyString" },
        "recipeSchemaVersion": { "const": "0.1.0" }
      }
    },
    "license": { "$ref": "#/$defs/rights" },
    "deterministicBuildReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generationSeed", "recipeSha256", "glbSha256", "canonicalManifest", "timestampFree", "localPathFree"],
      "properties": {
        "generationSeed": { "type": "integer" },
        "recipeSha256": { "$ref": "#/$defs/sha256" },
        "glbSha256": { "$ref": "#/$defs/sha256" },
        "canonicalManifest": { "const": true },
        "timestampFree": { "const": true },
        "localPathFree": { "const": true }
      }
    },
    "textureStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "uvPresent", "textureCount", "productionTexturingComplete", "note"],
      "properties": {
        "status": { "const": "UNAVAILABLE_NO_BLENDER" },
        "uvPresent": { "const": false },
        "textureCount": { "const": 0 },
        "productionTexturingComplete": { "const": false },
        "note": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "count": { "type": "integer", "minimum": 0 },
    "vec3": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "$ref": "#/$defs/vec3" },
        "max": { "$ref": "#/$defs/vec3" }
      }
    },
    "stringArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "textureDimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["width", "height"],
        "properties": {
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "stableNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stableId", "glbNodeName", "kind", "sourceId"],
      "properties": {
        "stableId": { "$ref": "#/$defs/nonEmptyString" },
        "glbNodeName": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["root", "scene-instance", "scene-part", "placement", "placement-part", "spline", "room", "socket"] },
        "sourceId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "partId", "nodeId"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["scan", "lock-on", "carry", "interaction", "communication", "handle", "load"] },
        "partId": { "$ref": "#/$defs/nonEmptyString" },
        "nodeId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "partId", "nodeId"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["wheel", "screen", "visual-center"] },
        "partId": { "$ref": "#/$defs/nonEmptyString" },
        "nodeId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "notice"],
      "properties": {
        "status": { "enum": ["NOASSERTION", "DECLARED"] },
        "licenseId": { "$ref": "#/$defs/nonEmptyString" },
        "notice": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
