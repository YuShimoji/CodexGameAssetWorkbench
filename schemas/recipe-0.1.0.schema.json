{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Codex Game Asset Workbench Recipe",
  "$id": "https://cgawe.local/schemas/recipe-0.1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "generationSeed",
    "materialDefinitions",
    "assetDefinitions",
    "variantSets",
    "sceneInstances",
    "splineDefinitions",
    "roomDefinitions",
    "socketDefinitions",
    "placementRules"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "generationSeed": {
      "type": "integer"
    },
    "materialDefinitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "color",
          "roughness",
          "metalness"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "roughness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "metalness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "assetDefinitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "parts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "primitive",
                "materialId",
                "transform"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "materialId": {
                  "type": "string",
                  "minLength": 1
                },
                "transform": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "position",
                    "rotation",
                    "scale"
                  ],
                  "properties": {
                    "position": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    },
                    "rotation": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    },
                    "scale": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                },
                "primitive": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "size"
                      ],
                      "properties": {
                        "type": {
                          "const": "box"
                        },
                        "size": {
                          "type": "array",
                          "minItems": 3,
                          "maxItems": 3,
                          "items": {
                            "type": "number"
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "radiusTop",
                        "radiusBottom",
                        "height",
                        "radialSegments"
                      ],
                      "properties": {
                        "type": {
                          "const": "cylinder"
                        },
                        "radiusTop": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "radiusBottom": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "height": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "radialSegments": {
                          "type": "integer",
                          "minimum": 3
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "size"
                      ],
                      "properties": {
                        "type": {
                          "const": "plane"
                        },
                        "size": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": {
                            "type": "number"
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "radius",
                        "widthSegments",
                        "heightSegments"
                      ],
                      "properties": {
                        "type": {
                          "const": "sphere"
                        },
                        "radius": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "widthSegments": {
                          "type": "integer",
                          "minimum": 3
                        },
                        "heightSegments": {
                          "type": "integer",
                          "minimum": 2
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "variantSets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "assetId",
          "partIds",
          "seed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "partIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hue": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          },
          "saturation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          },
          "brightness": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            }
          },
          "materialOverride": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "roughness": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "metalness": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "seed": {
            "type": "integer"
          }
        }
      }
    },
    "sceneInstances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "assetId",
          "transform"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "transform": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position",
              "rotation",
              "scale"
            ],
            "properties": {
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "rotation": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "scale": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "variantSetId": {
            "type": "string",
            "minLength": 1
          },
          "partOverrides": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "materialId": {
                  "type": "string",
                  "minLength": 1
                },
                "transform": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "position": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    },
                    "rotation": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    },
                    "scale": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "splineDefinitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "controlPoints",
          "closed",
          "interpolation",
          "sweepType",
          "radiusKeyframes",
          "widthKeyframes",
          "heightKeyframes",
          "resolutionPolicy",
          "materialId",
          "seed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "controlPoints": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          },
          "closed": {
            "type": "boolean"
          },
          "interpolation": {
            "enum": [
              "linear",
              "catmull-rom"
            ]
          },
          "sweepType": {
            "enum": [
              "rod",
              "road",
              "corridor"
            ]
          },
          "radiusKeyframes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "t",
                "value"
              ],
              "properties": {
                "t": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "widthKeyframes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "t",
                "value"
              ],
              "properties": {
                "t": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "heightKeyframes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "t",
                "value"
              ],
              "properties": {
                "t": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "resolutionPolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minSegments",
              "maxSegments",
              "segmentsPerUnit",
              "curvatureWeight",
              "dimensionChangeWeight"
            ],
            "properties": {
              "minSegments": {
                "type": "integer",
                "minimum": 1
              },
              "maxSegments": {
                "type": "integer",
                "minimum": 1
              },
              "segmentsPerUnit": {
                "type": "number",
                "minimum": 0
              },
              "curvatureWeight": {
                "type": "number",
                "minimum": 0
              },
              "dimensionChangeWeight": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "materialId": {
            "type": "string",
            "minLength": 1
          },
          "seed": {
            "type": "integer"
          }
        }
      }
    },
    "roomDefinitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "position",
          "width",
          "height",
          "depth",
          "floorY",
          "materialId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "depth": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "floorY": {
            "type": "number"
          },
          "materialId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "socketDefinitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "roomId",
          "type",
          "position",
          "orientation",
          "compatibleTags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "roomId": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "orientation": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "compatibleTags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "placementRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "type",
          "assetId",
          "origin",
          "direction",
          "jitter",
          "seed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "linear",
              "grid",
              "spline"
            ]
          },
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "splineId": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 1
          },
          "spacing": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "columns": {
            "type": "integer",
            "minimum": 1
          },
          "origin": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "direction": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "jitter": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position",
              "rotation",
              "scale"
            ],
            "properties": {
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "rotation": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "scale": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "variantSetId": {
            "type": "string",
            "minLength": 1
          },
          "seed": {
            "type": "integer"
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lodPolicies": {
          "type": "array"
        },
        "morphDefinitions": {
          "type": "array"
        },
        "destructionDefinitions": {
          "type": "array"
        },
        "environmentDefinitions": {
          "type": "array"
        },
        "spawnerDefinitions": {
          "type": "array"
        }
      }
    }
  }
}
